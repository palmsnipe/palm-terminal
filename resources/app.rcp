#include "resource.h"
#include "arm-resources.rcp"

DATA "code" ID 1 "code0001.bin"
DATA "pPen" ID RawPenResource "raw-pen.bin"

FORM ID HomeForm AT (0 0 160 160)
BEGIN
    TITLE "Terminal"
    LABEL "Host" AUTOID AT (8 22) FONT 0
    FIELD ID Host AT (8 34 108 13) EDITABLE SINGLELINE UNDERLINED MAXCHARS 95
    LABEL "Port" AUTOID AT (124 22) FONT 0
    FIELD ID Port AT (124 34 29 13) EDITABLE SINGLELINE UNDERLINED NUMERIC MAXCHARS 5
    LABEL "Username" AUTOID AT (8 56) FONT 0
    FIELD ID User AT (8 68 144 13) EDITABLE SINGLELINE UNDERLINED MAXCHARS 63
    BUTTON "Connect" ID Connect AT (8 101 144 18) FONT 1
    BUTTON "Profiles" ID Profiles AT (8 123 68 15)
    BUTTON "Keys" ID Keys AT (84 123 68 15)
    BUTTON "Settings" ID HomeSettings AT (8 142 68 14)
    BUTTON "Randomness" ID Seed AT (84 142 68 14)
END

FORM ID ListForm AT (0 0 160 160)
BEGIN
    TITLE "Terminal"
    LIST "" ID Items AT (7 21 146 54) VISIBLEITEMS 5 FONT 0
    BUTTON "<" ID Prev AT (7 77 22 14)
    BUTTON ">" ID Next AT (33 77 22 14)
    BUTTON "Use" ID Pick AT (59 77 42 14)
    BUTTON "Delete" ID Remove AT (105 77 48 14)
    BUTTON "Import" ID Import AT (7 95 70 14)
    BUTTON "Generate" ID Generate AT (83 95 70 14)
    BUTTON "Export .pub" ID Public AT (7 113 70 14)
    BUTTON "Use password" ID UsePassword AT (83 113 70 14)
    BUTTON "Host key..." ID HostKeyDetails AT (7 95 70 14) NONUSABLE
    BUTTON "Back" ID Back AT (7 140 60 14)
END

FORM ID TextForm AT (0 0 160 160)
BEGIN
    TITLE "Terminal"
    FIELD ID Value AT (7 65 146 14) EDITABLE SINGLELINE UNDERLINED MAXCHARS 127
    BUTTON "OK" ID Accept AT (8 118 65 15)
    BUTTON "Cancel" ID Cancel AT (85 118 65 15)
END

FORM ID SecretForm AT (0 0 160 160)
BEGIN
    TITLE "Terminal"
    BUTTON "OK" ID Accept AT (8 118 65 15)
    BUTTON "Cancel" ID Cancel AT (85 118 65 15)
END

FORM ID TrustForm AT (0 0 160 160)
BEGIN
    TITLE "Verify host key"
    BUTTON "Trust" ID Accept AT (8 117 42 15)
    BUTTON "Copy" ID CopyFingerprint AT (57 117 44 15)
    BUTTON "Cancel" ID Cancel AT (108 117 44 15)
END

FORM ID ProfileHostForm AT (0 0 160 160)
BEGIN
    TITLE "Saved host key"
    BUTTON "Forget key" ID ForgetHost AT (8 117 65 15)
    BUTTON "Back" ID Back AT (85 117 65 15)
END

FORM ID BusyForm AT (0 0 160 160)
BEGIN
    TITLE "Terminal"
    BUTTON "Cancel" ID Cancel AT (48 123 63 15)
END

FORM ID ShellForm AT (0 0 160 160)
BEGIN
    FIELD ID ShellText AT (1 131 115 14) EDITABLE SINGLELINE UNDERLINED MAXCHARS 255 NONUSABLE
    BUTTON "Send" ID Send AT (119 131 39 14) NONUSABLE
    BUTTON "Ctrl" ID Ctrl AT (1 143 24 16)
    BUTTON "Esc" ID Esc AT (26 143 22 16)
    BUTTON "Tab" ID Tab AT (49 143 22 16)
    BUTTON "Type" ID Type AT (72 143 25 16)
    BUTTON "History" ID History AT (98 143 34 16)
    BUTTON "Menu" ID ShellMenu AT (133 143 26 16)
    BUTTON "Older" ID ScrollUp AT (1 143 32 16) NONUSABLE
    BUTTON "Newer" ID ScrollDown AT (34 143 34 16) NONUSABLE
    BUTTON "Back to live" ID BackToLive AT (69 143 63 16) NONUSABLE
    LIST "Fullscreen" "Appearance..." "Copy visible text" "Paste into line" "Disconnect" ID SessionActions AT (52 72 106 63) VISIBLEITEMS 5 NONUSABLE
END

FORM ID SettingsForm AT (0 0 160 160)
BEGIN
    TITLE "Terminal Settings"
    LABEL "Font size" AUTOID AT (8 20) FONT 0
    POPUPTRIGGER "Regular (6x10)" ID SettingsFont AT (60 17 92 14) LEFTANCHOR
    LIST "Regular (6x10)" "Small (5x8)" "Large (8x13)" ID SettingsFontList AT (58 18 94 41) VISIBLEITEMS 3 NONUSABLE
    POPUPLIST ID SettingsFont SettingsFontList

    LABEL "Theme" AUTOID AT (8 37) FONT 0
    POPUPTRIGGER "Presets..." ID SettingsTheme AT (60 34 92 14) LEFTANCHOR
    LIST "Light on dark" "Dark on light" "Amber on black" ID SettingsThemeList AT (58 34 94 41) VISIBLEITEMS 3 NONUSABLE
    POPUPLIST ID SettingsTheme SettingsThemeList

    LABEL "Cursor" AUTOID AT (8 54) FONT 0
    POPUPTRIGGER "Block" ID SettingsShape AT (49 51 61 14) LEFTANCHOR
    LIST "Block" "Underline" "Bar" "Hidden" ID SettingsShapeList AT (46 51 68 52) VISIBLEITEMS 4 NONUSABLE
    POPUPLIST ID SettingsShape SettingsShapeList
    CHECKBOX "Blink" ID SettingsBlink AT (113 51 40 14)

    BUTTON "Text" ID SettingsText AT (8 68 37 14)
    BUTTON "Background" ID SettingsBackground AT (50 68 60 14)
    BUTTON "Cursor" ID SettingsCursor AT (115 68 39 14)
    CHECKBOX "Auto cursor color" ID SettingsMatch AT (8 96 97 12)
    BUTTON "Behavior" ID SettingsBehavior AT (109 95 44 14)
    BUTTON "Defaults" ID SettingsDefaults AT (8 144 43 14)
    BUTTON "Cancel" ID SettingsCancel AT (60 144 42 14)
    BUTTON "Save" ID SettingsSave AT (111 144 42 14)
END

FORM ID BehaviorForm AT (0 0 160 160)
BEGIN
    TITLE "Terminal Behavior"
    LABEL "Scrollback" AUTOID AT (8 26) FONT 0
    POPUPTRIGGER "96 lines" ID SettingsHistory AT (60 23 92 14) LEFTANCHOR
    LIST "Off" "48 lines" "96 lines" "192 lines" ID SettingsHistoryList AT (58 23 94 52) VISIBLEITEMS 4 NONUSABLE
    POPUPLIST ID SettingsHistory SettingsHistoryList

    CHECKBOX "Follow output" ID SettingsFollow AT (8 47 130 14)
    CHECKBOX "Audible bell" ID SettingsBell AT (8 68 130 14)
    CHECKBOX "Bright ANSI bold" ID SettingsBold AT (8 89 130 14)
    BUTTON "Back" ID Back AT (8 144 54 14)
END

ALERT ID InfoAlert
INFORMATION
BEGIN
    TITLE "Terminal"
    MESSAGE "^1"
    BUTTONS "OK"
END

ALERT ID ConfirmAlert
CONFIRMATION
BEGIN
    TITLE "Terminal"
    MESSAGE "^1"
    BUTTONS "Continue" "Cancel"
END

FORM ID RandomnessForm AT (0 0 160 160)
BEGIN
    TITLE "Randomness"
    BUTTON "Use seed" ID UseStylusSeed AT (5 142 72 15)
    BUTTON "Cancel" ID Cancel AT (83 142 72 15)
END

ALERT ID HostChangedAlert
WARNING
BEGIN
    TITLE "Host key changed"
    MESSAGE "This server presented a different key. Verify the replacement through a trusted source before forgetting the saved key."
    BUTTONS "Saved key" "Cancel"
END

ICONFAMILYEX
BEGIN
    BITMAP "icons/launcher-mono-1x.bmp" BPP 1 DENSITY 72
    BITMAP "icons/launcher-color-1x.bmp" BPP 8 DENSITY 72 TRANSPARENT 255 0 255
    BITMAP "icons/launcher-mono-2x.bmp" BPP 1 DENSITY 144
    BITMAP "icons/launcher-color-2x.bmp" BPP 8 DENSITY 144 TRANSPARENT 255 0 255
END

SMALLICONFAMILYEX
BEGIN
    BITMAP "icons/list-mono-1x.bmp" BPP 1 DENSITY 72
    BITMAP "icons/list-color-1x.bmp" BPP 8 DENSITY 72 TRANSPARENT 255 0 255
    BITMAP "icons/list-mono-2x.bmp" BPP 1 DENSITY 144
    BITMAP "icons/list-color-2x.bmp" BPP 8 DENSITY 144 TRANSPARENT 255 0 255
END

APPLICATIONICONNAME ID AppName "Terminal"
VERSION ID AppVersion "0.1.0"
STRING ID AppVersion "0.1.0"
